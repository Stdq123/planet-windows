#!/bin/sh
set -eu
repo_root=$(git rev-parse --show-toplevel)
# Fixture tests create separate repositories; inherited hook Git paths must not
# redirect their commands into this checkout, especially from linked worktrees.
git_local_env=$(git rev-parse --local-env-vars)
unset $git_local_env
# Pass Git's actual ref updates on stdin; use the same classifier as CI.
exec bun "$repo_root/scripts/check-changes.ts" pre-push "$1"
