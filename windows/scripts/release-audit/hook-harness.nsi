Unicode true
!ifndef OUTPUT
!error "Provide -DOUTPUT=..."
!endif
!ifndef UNSAFE
  !ifndef HOOK
  !error "Provide -DHOOK=..."
  !endif
  !include "${HOOK}"
!endif
Name "Planet Windows uninstall hook test"
OutFile "${OUTPUT}"
InstallDir "$LOCALAPPDATA\Programs\Planet Windows test"
RequestExecutionLevel user
Section
  SetOutPath "$INSTDIR"
  FileOpen $0 "$INSTDIR\Planet Windows.exe" w
  FileWrite $0 "test-only payload"
  FileClose $0
  FileOpen $0 "$INSTDIR\ipfs.exe" w
  FileWrite $0 "test-only payload"
  FileClose $0
  WriteUninstaller "$INSTDIR\Uninstall.exe"
SectionEnd
Section "Uninstall"
  !ifndef UNSAFE
    !insertmacro customUnInstall
  !endif
  ; This is the unconditional command generated by MyGo 0.7.3.
  RMDir /r "$INSTDIR"
SectionEnd
